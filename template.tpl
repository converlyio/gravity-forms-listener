___TESTS___

scenarios:
- name: Loads the fixed listener and reports success
  code: |-
    mock('injectScript', function(url, success, failure, cacheKey) {
      assertThat(url).isEqualTo('https://gtm-templates.converly.io/gravity-forms-listener.js');
      assertThat(cacheKey).isEqualTo('converly-gravity-forms-listener');
      success();
    });
    runCode({});
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Reports a failed script load
  code: |-
    mock('injectScript', function(url, success, failure) { failure(); });
    runCode({});
    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();

___NOTES___

Sends one gravity_form_submitted event per successful Gravity Forms submission, with the form ID. It reads no personal data. To catch submissions that end in a redirect, it switches each form to Gravity Forms' own AJAX submission method. Full setup guide at https://converly.io/gtm-templates/gravity-forms
